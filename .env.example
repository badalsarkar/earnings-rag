# Copy to .env and fill in. Loaded automatically by the CLIs and the API.

# Postgres — must match docker-compose.yml
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=earnings
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# pgAdmin (docker-compose only)
PGADMIN_EMAIL=admin@admin.com
PGADMIN_PASSWORD=admin

# Cohere — the SDK reads CO_API_KEY
CO_API_KEY=

# Optional
LOG_LEVEL=INFO
